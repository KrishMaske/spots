# Base URL for the Go edge (spotsd). Bare origin only — no trailing slash,
# no /v1 suffix (the API client owns the /v1 and /healthz paths).
#
# Pick the value for how you're running the app:
#   iOS simulator (Mac only, not available on this Windows dev box):
#     EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
#   Android emulator (AVD):
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
#   Physical device via Expo Go (the default dev target for this project):
#     EXPO_PUBLIC_API_BASE_URL=http://<your-dev-machine-LAN-IP>:8080
#
# See mobile/README.md ("Connecting to the backend") for how to find your
# LAN IP and why physical-device testing is the default here.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.175:8080
