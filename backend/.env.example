# backend/.env.example
# Copy to backend/.env and adjust as needed.
# backend/.env is gitignored — never commit real credentials.
#
# All variables are OPTIONAL; defaults are shown.
# The Go monolith reads SPOTS_* vars; the Python reco process reads RECO_*.

# ── Go monolith (spotsd) ─────────────────────────────────────────────────────

# TCP address the Go monolith listens on.
SPOTS_HTTP_ADDR=:8080

# Base URL of the Python reco service (used by /readyz to ping reco).
SPOTS_RECO_URL=http://localhost:8081

# ── Python reco process ───────────────────────────────────────────────────────

# Port the reco uvicorn process binds to.
# Passed to uvicorn via --port in the Taskfile; not read by the app itself.
RECO_PORT=8081

# ── AWS Cognito (auth edge) ───────────────────────────────────────────────────
# Read back from the CloudFormation stack after deploying
# backend/deploy/aws/cognito-user-pool.yml.  All three must be set for auth
# routes to be active; omit them to run the server without authentication
# (useful during local development before Cognito is deployed).
# App client IDs are NOT secret — they are safe to commit in non-prod configs.
# Client secrets, SES credentials, and admin keys must NEVER be committed.
#
SPOTS_COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/<your-user-pool-id>
SPOTS_COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/<your-user-pool-id>/.well-known/jwks.json
SPOTS_COGNITO_CALLBACK_URL=https://localhost:8080/callback
SPOTS_COGNITO_APP_CLIENT_ID=<your-app-client-id>
SPOTS_COGNITO_REGION=us-east-1

# ── Local infra — connection seams ────────────────────────────────────────────
# Postgres DSN — matches deploy/local/docker-compose.yml defaults.
# Now read by config.go (SPOTS_POSTGRES_URL) — wire a DB client to consume it.
# Start infra first: docker compose -f backend/deploy/local/docker-compose.yml up -d
SPOTS_POSTGRES_URL=postgres://spots:spots@localhost:5432/spots?sslmode=disable

# MinIO / S3-compatible object storage — matches docker-compose.yml defaults.
SPOTS_S3_ENDPOINT=http://localhost:9000
SPOTS_S3_ACCESS_KEY=spotsadmin
SPOTS_S3_SECRET_KEY=spotsdev123
SPOTS_S3_BUCKET=spots-media
SPOTS_S3_REGION=us-east-1          # MinIO ignores region; most S3 SDKs require one
SPOTS_S3_USE_PATH_STYLE=true       # MinIO requires path-style addressing

# ── Compose-level overrides (docker-compose.yml internal vars) ────────────────
# Set these (or put them in deploy/local/.env) to avoid port collisions or
# change dev credentials without editing the compose file itself.
#
# POSTGRES_USER=spots
# POSTGRES_PASSWORD=spots
# POSTGRES_DB=spots
# POSTGRES_PORT=5432
#
# MINIO_ROOT_USER=spotsadmin
# MINIO_ROOT_PASSWORD=spotsdev123   # must be >= 8 chars
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_BUCKET=spots-media
